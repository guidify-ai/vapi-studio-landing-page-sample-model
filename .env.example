PORT=9998
# local | prod. Outside prod every email subject starts with [ENV: LOCAL].
APP_ENV=local
# Docker `app` overrides DATABASE_URL to postgres://studio:studio@postgres:5432/sample_landing_llm.
DATABASE_URL=postgres://studio:studio@127.0.0.1:15435/sample_landing_llm
PUBLIC_BASE_URL=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app

# Human project identity — mirrored into config/project.identity.json
PROJECT_NAME=Sample Landing LLM — Planner
PROJECT_SLUG=sample-landing-llm

POC_BRAIN_PROFILE=planner
POC_COMPANY_NAME=Sample Studio
# Brain adapter + cheap model live in src/brain/brain.config.ts (not here).
# Set adapter there: studio-chatgpt | studio-claude | studio-gemini | studio-grok
# or mock-chatgpt | mock-claude | mock-gemini | mock-grok (deterministic, no API).
# Provider keys — only the selected live adapter’s key is required:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=   # or GEMINI_API_KEY=
# XAI_API_KEY=
#
# Vapi — create ONE assistant only (single-agent PoC; do not paste Squad JSON).
# Preferred: put that assistant’s id here so assistant-request returns { assistantId }.
# Leave unset to return a transient single assistant with Custom LLM + tools.
# POC_ASSISTANT_ID=
#
# Outbound “Call me” (landing → POST /studio/outbound-call):
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=   # imported Twilio/Telnyx/Vonage number id (not free Vapi numbers)
# VAPI_PHONE_NUMBER_READABLE="+1 (825) 435-9762"  # shown on LP so guests know the caller ID
# POC_ASSISTANT_ID=       # same saved assistant that hits this project's Custom LLM
#
# Experiment: dial from a Vapi-native number instead (separate Vapi org is fine).
# Saved assistants are org-scoped, so without VAPI_NATIVE_ASSISTANT_ID the call
# carries an inline assistant pointed at this deploy's Custom LLM (PUBLIC_BASE_URL).
# VAPI_OUTBOUND_MODE=twilio   # twilio (default) | vapi
# VAPI_NATIVE_API_KEY=        # private key of the org that owns the Vapi number
# VAPI_NATIVE_PHONE_NUMBER_ID=
# VAPI_NATIVE_PHONE_NUMBER_READABLE="+1 (531) 571-9314"
# VAPI_NATIVE_ASSISTANT_ID=
VAPI_TRANSFER_DESTINATION=
# Tool names: snake_case in this example. Live .env may keep dashboard camelCase.
VAPI_END_CALL_TOOL_NAME=end_call_tool
VAPI_TRANSFER_CALL_TOOL_NAME=transfer_call
VAPI_HANDOFF_TOOL_NAME=handoff
# Hard silence hangup (seconds). Match the Vapi assistant setting (default 120).
# VAPI_SILENCE_TIMEOUT_SECONDS=120

# Google reCAPTCHA v3 — required for public Studio chat / Call me (burns LLM tokens otherwise).
# Create keys at https://www.google.com/recaptcha/admin (reCAPTCHA v3).
# Add localhost + your production domain to the key allowlist.
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5

# Guidify ecosystem credentials — optional. When set, a private event hook
# (src/shadows/) forwards Studio events to Guidify infrastructure.
# VAPI_STUDIO_CLIENT_ID=
# VAPI_STUDIO_CLIENT_SECRET=

# Daily call logs live in this project's logs/ folder (console still prints)
LOG_DIR=logs
LOG_DAYS=14

# Resend — wrap-up / hot-lead alerts to Guidify (must fire early on first sample)
# Copy values from projects/vapi-studio-landing/.env when testing locally.
# Until guidify.ca is verified in Resend, use:
#   RESEND_FROM=Vapi Studio <onboarding@resend.dev>
#   HOT_LEAD_TO=<your Resend account email>
# After domain verify: RESEND_FROM=Mark Pyskunov <mpyskunov@guidify.ca> and HOT_LEAD_TO=mpyskunov@guidify.ca
# RESEND_ENABLED=true
# RESEND_API_KEY=
# RESEND_FROM=Mark Pyskunov <mpyskunov@guidify.ca>
# HOT_LEAD_TO=mpyskunov@guidify.ca
# Issue reports from the landing demo (falls back to HOT_LEAD_TO)
# ISSUE_REPORT_TO=mpyskunov@guidify.ca

# Docs answers read the public repos guidify-ai/vapi-studio and
# guidify-ai/vapi-studio-project. Optional token raises the GitHub API rate limit.
# GITHUB_TOKEN=
